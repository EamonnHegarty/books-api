{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "api",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true
  },
  "include": ["api/**/*", "tests"],
  "exclude": ["node_modules", "dist", "tests"]
}
